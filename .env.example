# ┌────────────────────────────────────────────────────┐
# │  Example .env file                                 │
# │  Copy to .env and replace the placeholder values.  │
# └────────────────────────────────────────────────────┘

# APP
ENVIRONMENT=development          # development | test | production
APP_PORT=8000
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false                   # set true for JSON logs in production

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# DATABASE
POSTGRES_USER=my_postgres_user
POSTGRES_PASSWORD=my_postgres_password
POSTGRES_DB=my_postgres_db
POSTGRES_HOST=localhost
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
POSTGRES_PORT=5432

# REDIS
REDIS_HOST=localhost
# Required. The compose stack refuses to start without it.
REDIS_PASSWORD=change_me
REDIS_PORT=6379

# AUTH (both secrets must be at least 32 characters)
JWT_ACCESS_SECRET=my_jwt_access_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=my_jwt_refresh_secret_key_minimum_32_characters_long
REDIS_DB=0
